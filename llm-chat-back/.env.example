MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=toy_chat
MYSQL_USER=toy_chat_user
MYSQL_PASSWORD=

JWT_SECRET=change-this-secret-now
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RUM_TIMING_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

SMS_API_URL=
SMS_REQUEST_TIMEOUT_MS=15000
SMS_RATE_LIMIT_WINDOW_MS=60000
SMS_RATE_LIMIT_MAX=3

CONVERSATION_PAGE_SIZE=20
MESSAGE_PAGE_SIZE=50
LLM_HISTORY_MESSAGE_LIMIT=80

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=3
RAG_MIN_SCORE=0.18
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_EMBEDDING_BATCH_SIZE=32

LLM_REQUEST_TIMEOUT_MS=60000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
SPAN_BODY_CAPTURE_MODE=metadata
SPAN_BODY_TAG_MAX=8192
