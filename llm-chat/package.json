{
  "name": "llm-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "version:sync": "node ../llm-chat-back/scripts/sync-dd-version.mjs",
    "predev": "npm run version:sync",
    "dev": "vite",
    "prebuild": "npm run version:sync && npm run verify:rum-v7",
    "build": "vite build && npm run sourcemaps:verify",
    "release:rum": "npm run build && npm run sourcemaps:upload && npm run sourcemaps:clean",
    "sourcemaps:plan": "node scripts/sourcemap-release.mjs plan",
    "sourcemaps:verify": "node scripts/sourcemap-release.mjs verify",
    "sourcemaps:upload": "node scripts/sourcemap-release.mjs upload",
    "sourcemaps:clean": "node scripts/sourcemap-release.mjs clean",
    "verify:rum-v7": "node scripts/verify-browser-sdk-v7.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:rum": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@datadog/browser-logs": "7.6.1",
    "@datadog/browser-rum": "7.6.1",
    "@datadog/browser-rum-react": "7.6.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@datadog/datadog-ci": "5.21.2",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
